{
  "info": {
    "name": "Splitwise MVP — Propsoch",
    "description": "Run `npm run db:reset && npm start`, then work down this collection.\n\nThere's no auth layer (the brief says not to build one), so every request carries an `X-User-Id` header. The three ids below come from the seed.\n\n| User | Id |\n|---|---|\n| Aarav Sharma | 11111111-1111-4111-8111-111111111111 |\n| Diya Patel | 22222222-2222-4222-8222-222222222222 |\n| Rohan Mehta | 33333333-3333-4333-8333-333333333333 |\n\nThe seed already has one expense: Aarav paid ₹1200 for dinner split three ways.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "aarav", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "diya", "value": "22222222-2222-4222-8222-222222222222" },
    { "key": "rohan", "value": "33333333-3333-4333-8333-333333333333" },
    { "key": "expenseId", "value": "" },
    { "key": "expenseVersion", "value": "0" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{aarav}}" }],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          },
          "response": []
        },
        {
          "name": "Update email and currency",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{aarav}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aarav.sharma@example.com\",\n  \"defaultCurrency\": \"INR\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          },
          "response": []
        },
        {
          "name": "Update with a bad currency → 400",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{aarav}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"defaultCurrency\": \"RUPEES\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          },
          "response": []
        },
        {
          "name": "Delete account while money is owed → 409",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-User-Id", "value": "{{diya}}" }],
            "description": "Diya owes Aarav ₹400 from the seeded expense, so she can't leave yet.",
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          },
          "response": []
        },
        {
          "name": "No X-User-Id → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Add an expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('expenseId', body.id);",
                  "pm.collectionVariables.set('expenseVersion', body.version);",
                  "",
                  "pm.test('shares add up to the total', () => {",
                  "  const sum = body.members.reduce((n, m) => n + Math.round(Number(m.share) * 100), 0);",
                  "  pm.expect(sum).to.eql(Math.round(Number(body.amount) * 100));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{aarav}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dinner at Toit\",\n  \"amount\": 100,\n  \"currency\": \"INR\",\n  \"date\": \"2026-09-08\",\n  \"members\": [\n    { \"userId\": \"{{aarav}}\" },\n    { \"userId\": \"{{diya}}\" },\n    { \"userId\": \"{{rohan}}\" }\n  ]\n}"
            },
            "description": "₹100 across three people doesn't divide evenly — the response shows 33.34 / 33.33 / 33.33, and the test above checks nothing was created or lost.",
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] }
          },
          "response": []
        },
        {
          "name": "Add one where the payer isn't splitting",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{aarav}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gift for Rohan\",\n  \"amount\": 500,\n  \"paidBy\": \"{{aarav}}\",\n  \"members\": [\n    { \"userId\": \"{{diya}}\" },\n    { \"userId\": \"{{rohan}}\" }\n  ]\n}"
            },
            "description": "Aarav pays but isn't one of the members, so he's owed the whole ₹500.",
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] }
          },
          "response": []
        },
        {
          "name": "EXACT split",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{aarav}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Groceries\",\n  \"amount\": 1000,\n  \"splitType\": \"EXACT\",\n  \"members\": [\n    { \"userId\": \"{{aarav}}\", \"amount\": 400 },\n    { \"userId\": \"{{diya}}\", \"amount\": 600 }\n  ]\n}"
            },
            "description": "Every member's amount stated outright. Nothing to round — they just have to add up.",
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] }
          },
          "response": []
        },
        {
          "name": "PERCENT split that won't divide evenly",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('shares still come to the total', () => {",
                  "  const sum = body.members.reduce((n, m) => n + Math.round(Number(m.share) * 100), 0);",
                  "  pm.expect(sum).to.eql(Math.round(Number(body.amount) * 100));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{aarav}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Three ways-ish\",\n  \"amount\": 10,\n  \"splitType\": \"PERCENT\",\n  \"members\": [\n    { \"userId\": \"{{aarav}}\", \"percent\": 33.33 },\n    { \"userId\": \"{{diya}}\", \"percent\": 33.33 },\n    { \"userId\": \"{{rohan}}\", \"percent\": 33.34 }\n  ]\n}"
            },
            "description": "Rounding each share on its own would give ₹3.33 three times — ₹9.99 against a ₹10 expense. Largest remainder hands the spare paisa back, so this comes out 3.33 / 3.33 / 3.34.",
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] }
          },
          "response": []
        },
        {
          "name": "Split that doesn't add up → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{aarav}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Groceries\",\n  \"amount\": 1000,\n  \"splitType\": \"EXACT\",\n  \"members\": [\n    { \"userId\": \"{{aarav}}\", \"amount\": 400 },\n    { \"userId\": \"{{diya}}\", \"amount\": 500 }\n  ]\n}"
            },
            "description": "SPLIT_MISMATCH, with the two totals in the message so the client can see what's off.",
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] }
          },
          "response": []
        },
        {
          "name": "Amount with too much precision → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{aarav}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sub-paisa\",\n  \"amount\": 10.005,\n  \"members\": [\n    { \"userId\": \"{{aarav}}\" },\n    { \"userId\": \"{{diya}}\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] }
          },
          "response": []
        },
        {
          "name": "My expenses",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{aarav}}" }],
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] }
          },
          "response": []
        },
        {
          "name": "My expenses this month",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{aarav}}" }],
            "description": "The date filter the activity log would sit on top of.",
            "url": {
              "raw": "{{baseUrl}}/expenses?from=2026-09-01&to=2026-09-30",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"],
              "query": [
                { "key": "from", "value": "2026-09-01" },
                { "key": "to", "value": "2026-09-30" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "One expense",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{aarav}}" }],
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "{{expenseId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update it",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('expenseVersion', pm.response.json().version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{aarav}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dinner at Toit (corrected)\",\n  \"amount\": 1200,\n  \"version\": {{expenseVersion}}\n}"
            },
            "description": "Send the version you last read. The balances get re-derived from the new split.",
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "{{expenseId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update with a stale version → 409",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{aarav}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 999,\n  \"version\": 0\n}" },
            "description": "Run the previous request first. This one is holding an old version, so it's rejected instead of overwriting.",
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "{{expenseId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Someone else's expense → 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{rohan}}" }],
            "description": "Only works if Rohan isn't in this one — try it after the 'Gift for Rohan' expense, using that id.",
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "{{expenseId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete it",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-User-Id", "value": "{{aarav}}" }],
            "description": "Soft deletes the expense and reverses everything it did to the balances, in one transaction.",
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "{{expenseId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Balances",
      "item": [
        {
          "name": "What I owe and am owed",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{aarav}}" }],
            "description": "Grouped by person, then by currency. `totals` is the net position per currency. Currencies aren't converted into each other.",
            "url": { "raw": "{{baseUrl}}/balances", "host": ["{{baseUrl}}"], "path": ["balances"] }
          },
          "response": []
        },
        {
          "name": "The same thing from the other side",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{diya}}" }],
            "description": "Same number, opposite direction — the pair is stored once, not twice.",
            "url": { "raw": "{{baseUrl}}/balances", "host": ["{{baseUrl}}"], "path": ["balances"] }
          },
          "response": []
        }
      ]
    }
  ]
}
